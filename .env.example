# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Settings -> API no painel do Supabase.
#
# A chave anon e publica: ela vai no bundle do navegador e o que protege os
# dados e o Row Level Security. Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
